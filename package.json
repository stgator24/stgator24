{
  "name": "monarch-money-prototype",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run start --filter=mobile",
    "dev:backend": "turbo run dev --filter=backend",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "turbo": "^2.0.3",
    "typescript": "^5.5.4"
  }
}
