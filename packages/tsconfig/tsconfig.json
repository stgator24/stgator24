{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@budget/ui": ["../ui/src"],
      "@budget/domain": ["../domain/src"],
      "@budget/schemas": ["../domain/src/schemas"],
      "@budget/types": ["../domain/src/types"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "*.test.ts", "*.spec.ts"]
}
